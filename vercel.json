{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "cd web && npm install",
  "buildCommand": "cd web && npm run build",
  "outputDirectory": "web/out",
  "framework": null,
  "trailingSlash": true,
  "redirects": [
    { "source": "/atlas", "destination": "/?p=atlas", "permanent": true },
    { "source": "/methods", "destination": "/?p=methods", "permanent": true },
    { "source": "/sources", "destination": "/?p=sources", "permanent": true },
    { "source": "/stories", "destination": "/?p=stories", "permanent": true },
    { "source": "/stories/:slug", "destination": "/?p=story&s=:slug", "permanent": true }
  ]
}
